{
  "$schema": "../src/config.schema.json",
  "apiPort": 4445,
  "listeners": {
    "http": {
      "port": 4444,
      "requests": {
        "^/test$": "file:httpResponse.json",
        "^/statusOnly$": "file:httpResponseStatusOnly.txt",
        "^/statusWithText$": "file:httpResponseStatusWithText.txt",
        "^/statusHttp$": "file:httpResponseStatusHttp.txt",
        "^/statusHttpVersion$": "file:httpResponseStatusHttpVersion.txt",
        "^/withProcessor$": {
          "sendResponse": true,
          "delay": 10,
          "response": "withProcessor"
        },
        "": "text:unknown request"
      },
      "responses": {
        "withProcessor": {
          "content": "file:httpResponse.json",
          "responseProcessor": "upperCase"
        }
      }
    }
  }
}
