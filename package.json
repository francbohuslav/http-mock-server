{
  "name": "http-mock-server",
  "version": "1.1.0",
  "description": "Mock server for HTTP, Kafka and AMQP",
  "main": "dist/index.js",
  "scripts": {
    "start": "node ./dist/index.js",
    "devel": "nodemon ./dist/index.js",
    "build": "tsc --project tsconfig.json --extendedDiagnostics",
    "watch": "tsc --watch --project tsconfig.json",
    "test": "jest -c jest.config.js",
    "test-watch": "jest -c jest.config.js --watch",
    "lint": "biome lint",
    "lint-fix": "biome lint --write",
    "format": "biome format --write",
    "check": "biome check"
  },
  "author": "Bogan <franc.bohuslav@gmail.com>",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/francbohuslav/http-mock-server.git"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "amqplib": "^2.0.1",
    "jsonc-parser": "^3.3.1",
    "kafkajs": "^2.2.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.4",
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "ts-jest": "^29.4.14",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
