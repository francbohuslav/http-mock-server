    "type": "git",
    "url": "git+https://github.com/francbohuslav/http-mock-server.git"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "amqplib": "^2.0.1",
    "jsonc-parser": "^3.3.1",
    "kafkajs": "^2.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.4",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "ts-jest": "^29.4.14",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1"
  },
  "engines": {
    "node": ">=22"
  }
