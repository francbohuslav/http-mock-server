{
  "$id": "http-mock-server/config.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ConfigFile",
  "type": "object",
  "required": [
    "apiPort",
    "listeners"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "apiPort": {
      "minimum": 1,
      "maximum": 65534,
      "type": "integer",
      "description": "Port for HTTP API"
    },
    "listeners": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "http": {
          "type": "object",
          "required": [
            "port",
            "requests"
          ],
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Whether HTTP listener is enabled"
            },
            "port": {
              "minimum": 1,
              "maximum": 65534,
              "type": "integer",
              "description": "Port for HTTP listener"
            },
            "requests": {
              "type": "object",
              "description": "URL regex → rule. The first matching regex wins, \"\" matches everything.",
              "patternProperties": {
                ".*": {
                  "$ref": "#/definitions/rule"
                }
              }
            },
            "responses": {
              "type": "object",
              "patternProperties": {
                ".*": {
                  "$ref": "#/definitions/httpresponse"
                }
              }
            }
          }
        },
        "kafka": {
          "type": "object",
          "patternProperties": {
            ".*": {
              "$ref": "#/definitions/mbhost"
            }
          }
        },
        "amqp": {
          "type": "object",
          "patternProperties": {
            ".*": {
              "$ref": "#/definitions/mbhost"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "mbhost": {
      "type": "object",
      "required": [
        "host"
      ],
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Whether message broker endpoint is enabled"
        },
        "host": {
          "type": "string",
          "description": "MB server address, e.g.: localhost:9092 or amqp://localhost"
        },
        "requests": {
          "type": "object",
          "description": "Topic/queue name → rule",
          "patternProperties": {
            ".*": {
              "$ref": "#/definitions/rule"
            }
          }
        },
        "responses": {
          "type": "object",
          "patternProperties": {
            ".*": {
              "$ref": "#/definitions/kafkaresponse"
            }
          }
        },
        "queueSettings": {
          "type": "object",
          "patternProperties": {
            ".*": {
              "type": "object"
            }
          }
        }
      }
    },
    "mbtopic": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sendResponse": {
          "type": "boolean",
          "description": "Brokers only: whether to send a reply (HTTP always replies)"
        },
        "delay": {
          "type": "integer",
          "description": "Delay in milliseconds between request and reply"
        },
        "response": {
          "type": "string",
          "description": "text:text response, file:response.txt, name of response or listener:name of response, e.g. kafka1:sampleResponse"
        }
      },
      "required": [
        "response"
      ]
    },
    "kafkaresponse": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "content": {
          "type": "string",
          "description": "text:text response\nfile:response.txt"
        },
        "targetTopic": {
          "type": "string",
          "description": "Name of topic"
        },
        "responseProcessor": {
          "type": "string",
          "description": "Function name of processor that transforms response. See file responses/processors.js"
        }
      }
    },
    "httpresponse": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "content": {
          "type": "string",
          "description": "text:text response\nfile:response.txt"
        },
        "responseProcessor": {
          "type": "string",
          "description": "Function name of processor that transforms response. See file responses/processors.js"
        }
      }
    },
    "rule": {
      "anyOf": [
        {
          "type": "string",
          "description": "text:text response\nfile:response.txt\nname of response\nlistener:name of response"
        },
        {
          "$ref": "#/definitions/mbtopic"
        }
      ]
    }
  }
}
