{
  "compilerOptions": {
    "module": "node16",
    "moduleResolution": "node16",
    "target": "es2022",
    "lib": [
      "es2023"
    ],
    "esModuleInterop": true,
    "isolatedModules": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "types": [
      "node"
    ],
    "strict": true,
    "resolveJsonModule": true
  },
  "include": [
    "./src/**/*"
  ]
}
