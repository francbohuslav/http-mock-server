{
  "folders": [
    {
      "name": "📝 Source",
      "path": "."
    },
    {
      "name": "🐋 Docker",
      "path": "../docker"
    }
  ],
  "extensions": {
    "recommendations": ["biomejs.biome"]
  },
  "settings": {
    "files.exclude": {
      "**/.git": true,
      "**/.svn": true,
      "**/.hg": true,
      "**/CVS": true,
      "**/.DS_Store": true,
      "dist": true
    },
    "git.enabled": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "always"
    },
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "biomejs.biome"
  }
}
